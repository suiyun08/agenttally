{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/st0012/cctop/hook-input.schema.json",
  "title": "cctop-hook Input",
  "description": "JSON payload piped to stdin of the cctop-hook binary. Tools translate their native events to this schema.",
  "type": "object",
  "required": ["session_id", "cwd", "hook_event_name"],
  "properties": {
    "session_id":      { "type": "string", "description": "Unique session identifier" },
    "cwd":             { "type": "string", "description": "Working directory of the session" },
    "hook_event_name": {
      "type": "string",
      "enum": [
        "SessionStart",
        "SessionEnd",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "Stop",
        "StopFailure",
        "PreCompact",
        "Notification",
        "PermissionRequest",
        "SubagentStart",
        "SubagentStop",
        "PostCompact",
        "SessionError"
      ],
      "description": "The hook event that triggered this payload"
    },
    "transcript_path":  {
      "type": ["string", "null"],
      "description": "Transcript path when available. Explicit null is distinct from omission."
    },
    "permission_mode":  { "type": "string" },
    "prompt":           { "type": "string" },
    "tool_name":        { "type": "string" },
    "tool_input":       { "type": "object", "description": "Tool input dict (values may be any JSON type)" },
    "notification_type": { "type": "string" },
    "message":          { "type": "string" },
    "title":            { "type": "string" },
    "trigger":          { "type": "string" },
    "error":            { "type": "string" },
    "is_interrupt":     { "type": "boolean" },
    "agent_id":         { "type": "string" },
    "agent_type":       { "type": "string" },
    "is_subagent":      {
      "type": "boolean",
      "description": "Whether this payload belongs to a subagent-owned session rather than a user-facing session"
    },
    "source":           {
      "type": "string",
      "description": "Legacy harness name, or the SessionStart kind in older Codex payloads"
    },
    "harness_name":     {
      "type": "string",
      "enum": ["cc", "codex", "opencode", "pi", "dsh"],
      "description": "Tool harness that produced this payload. Legacy plugins may still send this value in source."
    },
    "session_name":     { "type": "string", "description": "Display name for the session" },
    "last_assistant_message": {
      "type": "string",
      "description": "Claude's final text for the turn (Stop), or the API error string (StopFailure)"
    },
    "error_details":    { "type": "string", "description": "Optional detail for a StopFailure API error" },
    "background_tasks": {
      "type": "array",
      "items": { "type": "object" },
      "description": "In-flight background tasks reported on Stop; any entry means the session will resume without the user"
    },
    "session_crons":    {
      "type": "array",
      "items": { "type": "object" },
      "description": "Scheduled wakeups (CronCreate, ScheduleWakeup, /loop) reported on Stop"
    }
  },
  "additionalProperties": true,
  "x-cctop": {
    "harnesses": ["cc", "codex", "opencode", "pi", "dsh"],
    "binary_locations": [
      "~/.cctop/bin/cctop-hook",
      "/Applications/AgentTally.app/Contents/MacOS/cctop-hook",
      "~/Applications/AgentTally.app/Contents/MacOS/cctop-hook"
    ],
    "events_by_harness": {
      "cc": [
        "SessionStart",
        "SessionEnd",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "Stop",
        "StopFailure",
        "PreCompact",
        "Notification",
        "PermissionRequest",
        "SubagentStart",
        "SubagentStop"
      ],
      "codex": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PermissionRequest",
        "Stop"
      ],
      "opencode": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "Stop",
        "PreCompact",
        "PermissionRequest",
        "PostCompact",
        "SessionError"
      ],
      "pi": [
        "SessionStart",
        "SessionEnd",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "Stop",
        "PreCompact",
        "PostCompact"
      ],
      "dsh": [
        "SessionStart",
        "SessionEnd",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PermissionRequest",
        "Stop"
      ]
    }
  }
}
